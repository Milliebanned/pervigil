# Any OpenAI-compatible chat endpoint. Copy to .env and fill in.
LLM_BASE_URL=https://hackathon.bitgetops.com/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-max

# Optional: a Bitget Demo API key. With it, every paper position is also placed on Bitget's demo exchange.
BITGET_DEMO_API_KEY=
BITGET_DEMO_SECRET=
BITGET_DEMO_PASSPHRASE=

# Optional: Chainbase AgentKey (https://console.agentkey.app). Adds per-stock news for names that are moving.
AGENTKEY_API_KEY=
